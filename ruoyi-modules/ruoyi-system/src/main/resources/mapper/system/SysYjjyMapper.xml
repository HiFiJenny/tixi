<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysYjjyMapper">
    
    <resultMap type="SysYjjy" id="SysYjjyResult">
        <result property="yjjyId"    column="yjjy_id"    />
        <result property="yjjyName"    column="yjjy_name"    />
        <result property="createBy"    column="create_by"    />
        <result property="yjjyStatus"    column="yjjy_status"    />
        <result property="yjjyPath"    column="yjjy_path"    />
    </resultMap>

    <sql id="selectSysYjjyVo">
        select yjjy_id, yjjy_name, create_by, yjjy_status, yjjy_path from sys_yjjy
    </sql>

    <select id="selectSysYjjyList" parameterType="SysYjjy" resultMap="SysYjjyResult">
        <include refid="selectSysYjjyVo"/>
        <where>  
            <if test="yjjyName != null  and yjjyName != ''"> and yjjy_name like concat('%', #{yjjyName}, '%')</if>
            <if test="createBy != null  and createBy != ''"> and create_by = #{createBy}</if>
            <if test="yjjyStatus != null  and yjjyStatus != ''"> and yjjy_status = #{yjjyStatus}</if>
            <if test="yjjyPath != null  and yjjyPath != ''"> and yjjy_path = #{yjjyPath}</if>
        </where>
    </select>
    
    <select id="selectSysYjjyByYjjyId" parameterType="Long" resultMap="SysYjjyResult">
        <include refid="selectSysYjjyVo"/>
        where yjjy_id = #{yjjyId}
    </select>
        
    <insert id="insertSysYjjy" parameterType="SysYjjy" useGeneratedKeys="true" keyProperty="yjjyId">
        insert into sys_yjjy
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="yjjyName != null">yjjy_name,</if>
            <if test="createBy != null">create_by,</if>
            <if test="yjjyStatus != null">yjjy_status,</if>
            <if test="yjjyPath != null">yjjy_path,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="yjjyName != null">#{yjjyName},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="yjjyStatus != null">#{yjjyStatus},</if>
            <if test="yjjyPath != null">#{yjjyPath},</if>
         </trim>
    </insert>

    <update id="updateSysYjjy" parameterType="SysYjjy">
        update sys_yjjy
        <trim prefix="SET" suffixOverrides=",">
            <if test="yjjyName != null">yjjy_name = #{yjjyName},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="yjjyStatus != null">yjjy_status = #{yjjyStatus},</if>
            <if test="yjjyPath != null">yjjy_path = #{yjjyPath},</if>
        </trim>
        where yjjy_id = #{yjjyId}
    </update>

    <delete id="deleteSysYjjyByYjjyId" parameterType="Long">
        delete from sys_yjjy where yjjy_id = #{yjjyId}
    </delete>

    <delete id="deleteSysYjjyByYjjyIds" parameterType="String">
        delete from sys_yjjy where yjjy_id in 
        <foreach item="yjjyId" collection="array" open="(" separator="," close=")">
            #{yjjyId}
        </foreach>
    </delete>
</mapper>